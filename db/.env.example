# ===========================================
# FinGuru Backend - Environment Configuration
# ===========================================
# Copy this file to ".env" and fill in your own values.
# Command:  cp .env.example .env

# Port the backend server listens on
PORT=5000

# --- MongoDB connection string ---
# OPTION A: Local MongoDB (MongoDB installed on your machine)
MONGO_URI=mongodb://127.0.0.1:27017/finguru

# OPTION B: MongoDB Atlas (cloud, free tier)
# Get this from Atlas -> Database -> Connect -> Drivers.
# Replace <username>, <password> and the cluster address.
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/finguru?retryWrites=true&w=majority
